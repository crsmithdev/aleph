#!/bin/sh
# Run the CI checks before a push that updates main, and refuse one while GitHub CI on main is red.
# A push from a linked worktree gives this hook GIT_DIR. Unset git's repo
# vars, or each test fixture's git acts on this repo and not on its own.
unset $(git rev-parse --local-env-vars)
while read -r _ _ ref _; do
  if [ "$ref" = "refs/heads/main" ]; then
    # Empty when gh is missing or cannot read the runs, so the push goes on as before.
    last=$(gh run list --branch main --status completed --limit 1 --json conclusion -q '.[0].conclusion' 2>/dev/null)
    if [ "$last" = failure ] && [ -z "$ALEPH_ALLOW_RED_MAIN" ]; then
      echo "pre-push: GitHub CI on main is red: its latest finished run failed. To push the fix, prefix the push with ALEPH_ALLOW_RED_MAIN=1." >&2
      exit 1
    fi
    bun run typecheck && bun run test:all || exit 1
    exit 0
  fi
done
