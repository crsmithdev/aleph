{
  "name": "aleph",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --timeout=30000 --parallel=${ALEPH_TEST_PARALLEL:-$(nproc)}",
    "test:all": "ALEPH_BROWSER_TESTS=1 bun run test",
    "accept": "bun test --timeout=30000 --parallel=${ALEPH_TEST_PARALLEL:-$(nproc)} $(find acceptance -name '*.accept.ts' | sort | sed 's|^|./|')",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
