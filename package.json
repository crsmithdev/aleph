{
  "name": "aleph-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI operating system — daemon spine (Phase 1)",
  "scripts": {
    "daemon": "bun src/daemon.ts",
    "os": "bun src/cli/os.ts",
    "test": "bun test tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:live": "ALEPH_LIVE=1 bun test tests/live",
    "typecheck": "tsc --noEmit",
    "config:check": "bun src/cli/os.ts config show --effective --config config/aleph.example.toml >/dev/null && echo 'config ok'",
    "docs:check": "bun scripts/check-docs.ts",
    "build:cli": "bun build --compile --outfile dist/os src/cli/os.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.238",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "smol-toml": "^1.4.2",
    "ulid": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
