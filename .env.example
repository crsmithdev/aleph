# Names only — never commit values. Read by the supervisor (compose/systemd),
# injected as process env, and referenced from TOML as ${NAME}.
#
# Quote any value containing a space. An unquoted LANGFUSE_OTLP_AUTH truncates to
# "Basic" under `set -a; . .env`, and the only symptom is a single
# obs.export_failed{error:"Unauthorized"} while the daemon otherwise runs fine.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_ID=
# Langfuse OTLP ingestion: "Basic " + base64("<public-key>:<secret-key>") — quoted
LANGFUSE_OTLP_AUTH=""
LANGFUSE_PROJECT_ID=
# Langfuse server (compose/langfuse.yml)
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
CLICKHOUSE_PASSWORD=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
# Headless bootstrap of the Langfuse org, project, first user and API key pair.
# Set these before the first `up -d` and the UI never has to be touched; the
# project id is also what `os trace` puts in its deep links.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=""
LANGFUSE_INIT_USER_PASSWORD=
