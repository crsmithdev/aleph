# Names only — never commit values. Read by the supervisor (compose/systemd),
# injected as process env, and referenced from TOML as ${NAME}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_ID=
# Langfuse OTLP ingestion: "Basic " + base64("<public-key>:<secret-key>")
LANGFUSE_OTLP_AUTH=
LANGFUSE_PROJECT_ID=
# Langfuse server (compose/langfuse.yml)
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
CLICKHOUSE_PASSWORD=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
