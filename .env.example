# Compose secrets for compose/langfuse.yml. Names only; values live in .env (gitignored).
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=        # 64 hex chars
# Headless bootstrap: org, project, first user and API key pair are created on boot.
LANGFUSE_INIT_ORG_ID=aleph
LANGFUSE_INIT_ORG_NAME=aleph
LANGFUSE_INIT_PROJECT_ID=aleph-local
LANGFUSE_INIT_PROJECT_NAME=aleph
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=   # pk-lf-...
LANGFUSE_INIT_PROJECT_SECRET_KEY=   # sk-lf-...
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
