# The aleph UI on 127.0.0.1:3020. landing.ts restarts it by this name, and doctor.ts checks it.
#   systemctl --user link ~/aleph/jobs/systemd/aleph-ui.service
#   systemctl --user enable --now aleph-ui.service
#   journalctl --user -u aleph-ui -n 20
[Unit]
Description=aleph UI on 127.0.0.1:3020

[Service]
WorkingDirectory=%h/aleph
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/aleph/bin/aleph-ui --port 3020
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
