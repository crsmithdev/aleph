# gpt-oss-20b on 127.0.0.1:8012 from llama-server (CUDA build under ~/.local/src/llama.cpp).
# Stop the hand-started Ollama serve and sidetone.service first; see
# docs/findings/2026-11-04-gpt-oss-20b-llama-server.md.
#   ln -sfn ~/.ollama/models/blobs/sha256-8ecb5d4ad6172c63f9cbf1a07a04e525985a8a11a6e516da02b674c4010de716 ~/.local/share/gpt-oss-20b.gguf
#   systemctl --user link ~/aleph/jobs/systemd/aleph-gpt-oss.service
#   systemctl --user enable --now aleph-gpt-oss.service
# At start, jobs/lib/gpt-oss-start.ts reads the free VRAM (nvidia-smi) and passes the smallest
# --n-cpu-moe (0 to 24) whose GPU share plus 1,536 MiB headroom fits; 12 when the read fails.
#   journalctl --user -u aleph-gpt-oss -n 20
[Unit]
Description=gpt-oss-20b on 127.0.0.1:8012

[Service]
WorkingDirectory=%h/.local/src/llama.cpp
Environment=PATH=%h/.local/bin:/usr/local/cuda/bin:/usr/lib/wsl/lib:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun %h/aleph/jobs/lib/gpt-oss-start.ts
Restart=always
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=default.target
