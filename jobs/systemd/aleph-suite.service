# The full suite on origin/main of each factory repo, recorded as the baseline. See docs/factory.md.
#   systemctl --user link ~/aleph/jobs/systemd/aleph-suite.service
#   systemctl --user enable --now ~/aleph/jobs/systemd/aleph-suite.timer
#   journalctl --user -u aleph-suite -n 20
[Unit]
Description=aleph full suite on origin/main

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/aleph
ExecStart=%h/.bun/bin/bun %h/aleph/jobs/cli.ts suite
