# Every minute. The tick starts only periodic work, each step on its own due rule (jobs/lib/transitions/tick.ts); no transition waits for it. `aleph pause` stops the runs, not the timer.
[Unit]
Description=aleph factory tick, every minute

[Timer]
OnBootSec=10min
OnStartupSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
